{
  "swagger": "2.0",
  "info": {
    "title": "rlog-admin API",
    "version": "1.0.0",
    "description": "Local administration API for rlog.d",
    "contact": {
      "name": "Ukama Inc.",
      "url": "http://www.ukama.com",
      "email": "hello@ukama.com"
    },
    "license": {
      "name": "Mozilla Public License 2.0",
      "url": "https://www.mozilla.org/en-US/MPL/2.0/"
    }
  },
  "host": "127.0.0.1:18011",
  "schemes": ["http"],
  "produces": ["application/json", "text/plain"],
  "paths": {
    "/v1/ping": {
      "get": {
        "summary": "Check service availability",
        "responses": {
          "200": {
            "description": "Service is running",
            "schema": {"type": "string"}
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "summary": "Get the rlog.d version",
        "responses": {
          "200": {
            "description": "Version string",
            "schema": {"type": "string"}
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Get local logging status",
        "responses": {
          "200": {
            "description": "Current canonical-store and ingest status",
            "schema": {"type": "object"}
          },
          "503": {
            "description": "Canonical storage is unavailable"
          }
        }
      }
    },
    "/v1/level": {
      "get": {
        "summary": "Get the current rlog.d log level",
        "responses": {
          "200": {
            "description": "Current level",
            "schema": {"type": "string"}
          }
        }
      }
    },
    "/v1/level/{level}": {
      "post": {
        "summary": "Set the rlog.d log level",
        "parameters": [
          {
            "name": "level",
            "in": "path",
            "required": true,
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error",
              "critical"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Updated level",
            "schema": {"type": "string"}
          },
          "400": {
            "description": "Invalid level"
          }
        }
      }
    }
  }
}
