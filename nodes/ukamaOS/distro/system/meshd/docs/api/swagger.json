{
  "swagger": "2.0",
  "info": {
    "title": "Mesh.d API",
    "version": "1.0.0",
    "description": "API documentation for the Mesh.d application",
    "contact": {
      "name": "Ukama Inc.",
      "url": "http://www.ukama.com",
      "email": "hello@ukama.com"
    },
    "license": {
      "name": "Mozilla Public License 2.0 (MPLV2)",
      "url": "https://www.mozilla.org/en-US/MPL/2.0/"
    }
  },
  "host": "localhost:18002",
  "schemes": ["http"],
  "paths": {
    "/v1/ping": {
      "get": {
        "summary": "Ping the mesh service",
        "responses": {
          "200": {
            "description": "The local service is responding"
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "summary": "Get the mesh service version",
        "responses": {
          "200": {
            "description": "Version string",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "/v1/ready": {
      "get": {
        "summary": "Get local service readiness",
        "description": "Remote mesh connectivity is reported separately.",
        "responses": {
          "200": {
            "description": "The local mesh service is ready",
            "schema": {
              "$ref": "#/definitions/ReadyResponse"
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Get remote mesh connectivity",
        "responses": {
          "200": {
            "description": "Current websocket connection state",
            "schema": {
              "$ref": "#/definitions/StatusResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ReadyResponse": {
      "type": "object",
      "required": ["ready"],
      "properties": {
        "ready": {
          "type": "boolean"
        }
      }
    },
    "StatusResponse": {
      "type": "object",
      "required": ["connected", "reason", "changedAt"],
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "changedAt": {
          "type": "integer",
          "format": "int64"
        }
      }
    }
  }
}
