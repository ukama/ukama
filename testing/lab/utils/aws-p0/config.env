# AWS CLI profile is optional. Leave empty to use the normal AWS credential chain.
AWS_PROFILE=ukama
AWS_REGION=us-east-1

# S3 is the mailbox between the local controller and disposable workers.
S3_BUCKET=ukama-lab-p0-results-003664043471
S3_PREFIX=p0
S3_RETENTION_DAYS=14

# Worker EC2 configuration.
# AMI_ID must be a tested Ukama-lab worker image. See README.md.
AMI_ID=ami-00b4dab092d743ec2
INSTANCE_TYPE=c7i.xlarge
INSTANCE_PROFILE_NAME=ukama-lab-p0-worker
IAM_ROLE_NAME=ukama-lab-p0-worker
SECURITY_GROUP_NAME=ukama-lab-p0-worker

# setup.sh discovers the default VPC/subnet when these are empty and writes
# resolved IDs to .state.env. Set explicit IDs for a non-default VPC.
VPC_ID=vpc-2a924c57
SUBNET_ID=subnet-50f17336
ASSOCIATE_PUBLIC_IP=true
SECURITY_GROUP_ID=sg-04b7f1592695a4402

# Root volume for node images and scenario artifacts.
ROOT_VOLUME_GB=250
ROOT_VOLUME_TYPE=gp3

# Worker lifetime and local status refresh.
WORKER_TIMEOUT_MINUTES=180
STATUS_INTERVAL_SECONDS=10
POLL_INTERVAL_SECONDS=10
MAX_WORKERS=20
DEFAULT_WORKERS=10
CONTROLLER_TIMEOUT_MINUTES=240

# Secret created/updated by setup.sh from credentials.env.
SECRET_ID=ukama-lab/udev

# Local output directory, relative to the ukama-lab repository unless absolute.
LOCAL_RUNS_DIR=runs/p0-aws
DELETE_S3_AFTER_COLLECT=false

# Optional factory preparation on the controller before workers launch.
# 0 disables it. "auto" uses the selected scenarios. A number ensures at least
# that many bundles, subject to the local runner's normal factory calculation.
FACTORY_NODE_TARGET=0
FACTORY_HEADROOM_PERCENT=10

# EC2 worker environment. The worker receives these non-secret values through
# a plain input file in S3.
UKAMA_LAB_SIM_TYPE=ukama_data
UKAMA_LAB_WAREHOUSE_URL=http://warehouse-ukama.udev.ukama.com
UKAMA_LAB_FACTORY_URL=http://factory-ukama.udev.ukama.com
ULAB_FACTORY_SEED_URL=https://factory-ukama.udev.ukama.com
ULAB_UKAMA_AGENT_NODE_GW_URL=https://ukamaagent-nodegateway-ukama.udev.ukama.com:8080/
ULAB_UKAMA_AGENT_API_GW_URL=https://ukamaagent-ukama.udev.ukama.com:8080/

# Optional runner behavior.
UKAMA_LAB_DUMP_BFF_CURL=1
ULAB_CDR_WAIT_SEC=5
ULAB_CDR_DIAG_STRICT=0
ULAB_OVS_ALLOW_UNMETERED_FALLBACK=1
ULAB_CDR_DIAG_DISABLE=1

# Optional software-update values used by scenarios.
ULAB_SOFTWARE_CURRENT_VERSION=
ULAB_SOFTWARE_TARGET_VERSION=
ULAB_SOFTWARE_UNAVAILABLE_VERSION=
ULAB_SOFTWARE_NEXT_VERSION=
BACKEND_GATEWAY_INSTANCE_ID=i-0c80765ae1a67ee36
BACKEND_GATEWAY_AUTO_SETUP=true
BACKEND_GATEWAY_START_IF_STOPPED=true
BACKEND_GATEWAY_SSH_USER=ubuntu
BACKEND_GATEWAY_SSH_KEY=/home/kashif/VirtualNodePEM.pem
BACKEND_GATEWAY_SSH_HOST=ec2-100-57-157-156.compute-1.amazonaws.com
BACKEND_GATEWAY_PREFER_PRIVATE_IP=false
BACKEND_GATEWAY_MANAGE_SSH_INGRESS=true
BACKEND_ROUTE_CIDR=10.0.0.0/8
BACKEND_TEST_IP=10.0.101.241
P0_CONNECT_TIMEOUT_SECONDS=15
P0_HTTP_TIMEOUT_SECONDS=25
