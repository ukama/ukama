{
  "version": "0.2.0",
  "entity": "node",
  "file": "nodeState.json",
  "states": [
    {
      "name": "Unknown",
      "description": "Node is registered but not heard from yet",
      "events": ["online", "offline", "health"],
      "timeout": { "seconds": 60, "to_state": "Initializing" },
      "transition": [
        { "to_state": "Initializing", "trigger": ["online", "health"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    },
    {
      "name": "Initializing",
      "description": "Node is coming up",
      "events": ["online", "offline", "update", "platformready", "ready", "fault"],
      "timeout": { "seconds": 60, "to_state": "Updating" },
      "transition": [
        { "to_state": "Updating", "trigger": ["update"] },
        { "to_state": "Ready", "trigger": ["platformready", "ready"] },
        { "to_state": "Faulty", "trigger": ["fault"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    },
    {
      "name": "Updating",
      "description": "Node is applying software updates",
      "events": ["online", "offline", "rebooted", "platformready", "ready", "fault"],
      "timeout": { "seconds": 60, "to_state": "Configuring" },
      "transition": [
        { "to_state": "Initializing", "trigger": ["rebooted"] },
        { "to_state": "Ready", "trigger": ["platformready", "ready"] },
        { "to_state": "Faulty", "trigger": ["fault"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    },
    {
      "name": "Configuring",
      "description": "Node is applying its configuration",
      "events": ["online", "offline", "configapplied", "platformready", "ready", "fault"],
      "timeout": { "seconds": 60, "to_state": "Ready" },
      "transition": [
        { "to_state": "Ready", "trigger": ["configapplied", "platformready", "ready"] },
        { "to_state": "Faulty", "trigger": ["fault"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    },
    {
      "name": "Ready",
      "description": "Node is up and waiting for site assignment",
      "events": ["online", "offline", "assign", "update", "fault"],
      "transition": [
        { "to_state": "Operational", "trigger": ["assign"] },
        { "to_state": "Updating", "trigger": ["update"] },
        { "to_state": "Faulty", "trigger": ["fault"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    },
    {
      "name": "Operational",
      "description": "Node is assigned to a site and serving",
      "events": ["online", "offline", "release", "update", "fault", "offboard"],
      "transition": [
        { "to_state": "Ready", "trigger": ["release"] },
        { "to_state": "Updating", "trigger": ["update"] },
        { "to_state": "Faulty", "trigger": ["fault"] },
        { "to_state": "Offboarded", "trigger": ["offboard"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    },
    {
      "name": "Faulty",
      "description": "Node reported a fault",
      "events": ["online", "offline", "recover", "offboard"],
      "transition": [
        { "to_state": "Initializing", "trigger": ["recover"] },
        { "to_state": "Offboarded", "trigger": ["offboard"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    },
    {
      "name": "Offboarded",
      "description": "Node released from the organisation",
      "events": ["online", "offline", "onboarding"],
      "transition": [
        { "to_state": "Unknown", "trigger": ["online", "onboarding"] }
      ],
      "substate": {
        "events": ["online", "offline"],
        "transition": [
          { "to_state": "on", "trigger": ["online"] },
          { "to_state": "off", "trigger": ["offline"] }
        ]
      }
    }
  ]
}
