Subject: [{{ .Values.ORG}}] Your top-up is confirmed
Content-Type: text/html; charset="UTF-8"

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Your top-up is confirmed</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f4f5f7;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f5f7;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" style="width:600px; max-width:100%; background-color:#ffffff; border-radius:10px; overflow:hidden; border:1px solid #e6e8eb;">
            <tr>
              <td style="height:4px; background-color:#1D90F8; font-size:0; line-height:0;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:28px 40px 8px 40px; font-family:Arial,Helvetica,sans-serif;">
                <span style="font-size:22px; font-weight:bold; letter-spacing:0.5px; color:#1D90F8;">ukama</span>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 40px 0 40px; font-family:Arial,Helvetica,sans-serif; color:#1a1a1a;">
                <h1 style="margin:0 0 16px 0; font-size:24px; font-weight:700; color:#1a1a1a;">Your top-up is confirmed</h1>
                <p style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#3c4149;">Hi {{.Values.SUBSCRIBER}},</p>
                <p style="margin:0 0 24px 0; font-size:15px; line-height:1.6; color:#3c4149;">
                  Your new data plan has been added to your account on the <strong>{{.Values.NETWORK}}</strong> network. You now have <strong>{{.Values.PACKAGES_COUNT}}</strong> plan(s) queued &mdash; each one activates once the previous plan is used up or expires.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:0 40px;">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border:1px solid #e6e8eb; border-radius:8px; background-color:#fafbfc;">
                  <tr>
                    <td style="padding:16px 20px 6px 20px; font-family:Arial,Helvetica,sans-serif; font-size:12px; font-weight:700; letter-spacing:0.6px; text-transform:uppercase; color:#8a929e;">Plan added</td>
                  </tr>
                  <tr>
                    <td style="padding:0 20px 16px 20px; font-family:Arial,Helvetica,sans-serif;">
                      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size:14px; color:#3c4149;">
                        <tr>
                          <td style="padding:7px 0; color:#8a929e;">Plan</td>
                          <td style="padding:7px 0; text-align:right; font-weight:600; color:#1a1a1a;">{{.Values.PACKAGE}}</td>
                        </tr>
                        <tr>
                          <td style="padding:7px 0; color:#8a929e; border-top:1px solid #edeff2;">Details</td>
                          <td style="padding:7px 0; text-align:right; font-weight:600; color:#1a1a1a; border-top:1px solid #edeff2;">{{.Values.PACKAGES_DETAILS}}</td>
                        </tr>
                        <tr>
                          <td style="padding:7px 0; color:#8a929e; border-top:1px solid #edeff2;">Expires</td>
                          <td style="padding:7px 0; text-align:right; font-weight:600; color:#1a1a1a; border-top:1px solid #edeff2;">{{.Values.EXPIRATION_DATE}}</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px 8px 40px; font-family:Arial,Helvetica,sans-serif; color:#3c4149;">
                <p style="margin:0 0 20px 0; font-size:15px; line-height:1.6;">
                  Track your usage and manage your queued plans anytime in the Ukama subscriber app.
                </p>
                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="border-radius:6px; background-color:#1D90F8;">
                      <a href="https://www.ukama.com" target="_blank" style="display:inline-block; padding:12px 28px; font-family:Arial,Helvetica,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:6px;">Manage your plans</a>
                    </td>
                  </tr>
                </table>
                <p style="margin:24px 0 0 0; font-size:15px; line-height:1.6;">Thanks,<br />The Ukama Team</p>
              </td>
            </tr>
            <tr>
              <td style="padding:28px 40px 32px 40px;">
                <div style="border-top:1px solid #e6e8eb; padding-top:20px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:1.6; color:#8a929e; text-align:center;">
                  <p style="margin:0 0 8px 0;">&copy; Ukama Inc. &middot; 1233 Quarry Lane #115, Pleasanton, CA 94566</p>
                  <p style="margin:0;">
                    <a href="https://x.com/ukamanetworks" target="_blank" style="color:#1D90F8; text-decoration:none; margin:0 8px;">X</a>
                    <a href="https://www.linkedin.com/company/ukama" target="_blank" style="color:#1D90F8; text-decoration:none; margin:0 8px;">LinkedIn</a>
                  </p>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
