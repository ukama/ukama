DNSIP=8.8.8.8
ENABLE_ZEN5_GPIO18=1
OVRDRFDSP=1
SYNCBY=gps
atten1=18
atten2=18
autoload=n
baudrate=115200
bf=bootoct $(flash_unused_addr) forceboot numcores=$(numcores)
boardname=zen
bootby=flash
bootcbyflash=gunzip 0x17e20000 0x20000000; cp.l 0x18320000 0x30800000 0xA00000; bootoctlinux 0x20000000 coremask=0x7 endbootargs rd_name=initrd mem=512M;
bootcbytftp=tftp 0x21000000 lsm_os.gz; gunzip 0x21000000 0x20000000 0x1000000; tftp 0x30800000 lsm_rd.gz; bootoctlinux 0x20000000 coremask=0x7 endbootargs rd_name=initrd mem=512M;
bootcmd=run eth_switch_init; sleep 2; ping 10.5.5.1; run eth_switch_init; sleep 2; run namedalloc; run bootcby${bootby};
bootdelay=0
bootloader_flash_update=bootloaderupdate
burn_app=erase $(flash_unused_addr) +$(filesize);cp.b $(fileaddr) $(flash_unused_addr) $(filesize)
bw=20
cfgloadby=flash
enbctrlrf=1
env_addr=0x1fbe0000
env_size=0x20000
eth_switch_init=mw64 0x00011800B0001000 0x0140
ethact=octeth0
ethaddr=00:01:02:03:04:05
flash_base_addr=0x17c00000
flash_size=0x8000000
flash_unused_addr=0x17d80000
flash_unused_size=0x7e80000
gain1=50
gain2=50
gatewayip=10.102.81.1
httpdenable=1
i2cinit=i2c dev 0; i2c probe; i2c dev 1;i2c mw 0x70.1 0x01 1; i2c probe; 
ipaddr=10.102.81.61
linux_cf=fatload ide 0 $(loadaddr) vmlinux.64;bootoctlinux $(loadaddr)
loadaddr=0x20000000
ls=fatls ide 0
mk_ubootenv=1
mode=e2e
named_block_addr=0x30800000
named_block_size=0x2800000
namedalloc=namedalloc dsp-dump 0x400000 0x7f4D0000; namedalloc cazac 0x630000 0x7f8D0000; namedalloc pf4cazac 0x13000 0x84000000; namedalloc cpu-dsp-if 0x100000 0x7ff00000; namedalloc dsp-log-buf 0x4000000 0x80000000; namedalloc initrd 0x2800000 0x30800000;
netmask=255.255.255.0
numcores=4
octeon_failsafe_mode=0
octeon_ram_mode=0
partition=nor0,5
pseudowww=1
pwdb_in_flash=1
rftarget=ad9362
rxfreq=1730
serverip=10.5.5.1
startapp=1
stderr=serial
stdin=serial
stdout=serial
swloadby=flash
target=zen
tcxo=pwm
tip=1
trx=1
txfreq=1825
uboot_flash_addr=0x17cc0000
uboot_flash_size=0xc0000
ucliovrd=0
web_user=admin
web_user1=user
webuilog=1
logdispen=2
mode_test=dl
mtdids=nor0=octeon_nor0
ptp1ppsen=0
ptpenable=0
pwmreghigh=24744
pwmreglow=37376
