#!/sbin/openrc-run

description="Reset the u-boot bootcount after a good boot"

depend() {
    need localmount
    after starterd
}

start() {
    ebegin "Resetting u-boot bootcount"
    mountpoint -q /media/boot || mount /media/boot
    fw_setenv bootcount 0
    eend $? "u-boot bootcount was not reset, after 3 more boots u-boot marks this slot bad"
}
